export KUBECONFIG="$PWD/benchmarks/k8s/kubeconfig"
watch_file config.env
if [[ -f "$PWD/config.env" ]]; then
  # shellcheck source=/dev/null
  source "$PWD/config.env"
fi
# config.env used to offer GIT_PROTOCOL=https. Worker clones are SSH-only.
case "${GIT_PROTOCOL:-ssh}" in
  ssh|SSH) ;;
  *)
    echo "error: git cloning is SSH-only. Remove GIT_PROTOCOL from config.env." >&2
    exit 1
    ;;
esac
export GIT_PROTOCOL=ssh
