# Roshanfer AE evaluator settings (EuroSys 2027 #1195)
#
#   cp evaluator.env.example evaluator.env
#   edit evaluator.env
#
# Sourced by direnv (.envrc) and/or run_tests.sh once those callers are wired.
# Do not commit evaluator.env. Do not put keys, passwords, or tokens here.

# SSH user on CloudLab / cluster nodes (also default for --cloudlab-ssh-user)
EVALUATOR_SSH_USER="your_cloudlab_username"

# Manifest XML from the CloudLab portal (required for --remote)
EVALUATOR_CLOUDLAB_MANIFEST="$HOME/cloudlab-manifest.xml"

# Docker Hub user or registry/user prefix. Must be able to docker login + push.
EVALUATOR_DOCKER_REGISTRY="your_dockerhub_username"

# Local SSH user for the one-machine tutorial (user@localhost)
EVALUATOR_LOCAL_USER="$(whoami)"

# Optional. run_tests.sh / exec.runner already set TARGET_ADDR=nodeN.
# EVALUATOR_TARGET_ADDR="node0"

# Optional. Default on remote generators is ~/roshanfer-experiments
# EVALUATOR_REMOTE_REPO_PATH="~/roshanfer-experiments"
