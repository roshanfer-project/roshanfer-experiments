# Copy to config.env (gitignored) and edit once.
# Scripts re-read config.env on every start; direnv also loads it for the interactive shell.

# Execution mode
REQUIRE_REMOTE=1               # 1 = run_tests.sh refuses local mode (AEC default)

# SSH — every hosts line must be user@host (no SSH_USER fallback)
CONTROL_ON_CLUSTER=1           # 1 = control machine is a cluster node; fetch via scripts/fetch_manifest.sh
CLOUDLAB_SSH_USER=             # required for --remote; picks <login> in the manifest
CLOUDLAB_MANIFEST=./manifest.xml

# Docker — public Hub; leave as-is unless you rebuild to your own registry
REGISTRY=farzad1132
IMAGE_TAG=latest               # stable tag on Hub; empty = path-hash (author isolation)
SKIP_BUILD=0                   # 1 = skip build.sh (no docker push); images from scripts/build.sh

# Git — remotes + protocol
GIT_PROTOCOL=ssh               # ssh | https
GIT_HOST=github.com
GIT_ORG=farzad1132
REPO_EXPERIMENTS=roshanfer-experiments
REPO_BENCHMARKS=benchmarks
REPO_RWG=rwg
REPO_SIDECAR=roshanfer-sidecar
