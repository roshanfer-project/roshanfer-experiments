{
  "#": "Sample configuration for the experiment execution framework. Copy to config.json and edit.",
  "output_base_dir": "./experiment_runs",
  "experiment_index": "110",
  "prometheus_url": "http://192.168.1.100:9091",
  "raw_artifact_subdir": "raw",
  "metrics_subdir": "metrics",
  "default_retries": 3,

  "remote_microservice_host": "192.168.1.100",
  "remote_microservice_user": "farzad",
  "remote_microservice_path": "/home/farzad/files/ppm/bench/social/exec",
  "k6_scripts_root": "bench/social/k6",
  "bench": "social",

  "ssh_binary": "ssh",
  "docker_compose_binary": "docker-compose",
  "git_root": "../..",

  "plotting_enabled": true,
  "plot_output_subdir": "plots",

  "experiment_defaults": {
    "latency-and-goodput-vs-load": {
      "duration_sec": 10
    }
  },

  "expansion": {
    "latency-and-goodput-vs-load": {
      "strategy": "per_load_rate", 
      "sleep_between_units_sec": 5
    }
  },

  "slos": {
    "compose-post": 90,
    "read-home-timeline": 20,
    "read-user-timeline": 20
  },

  "metrics": {},

  "experiment_metrics": {
    "latency-and-goodput-vs-load": {
      "latency_p50": "histogram_quantile(0.5, sum(rate(ppm_k6_success_req_latency_milliseconds_bucket{api=\"{api}\"}[{rate_interval}])) by (le))",
      "latency_p95": "histogram_quantile(0.95, sum(rate(ppm_k6_success_req_latency_milliseconds_bucket{api=\"{api}\"}[{rate_interval}])) by (le))",
      "goodput": "rate(ppm_k6_goodput_counter_total{api=\"{api}\"}[{rate_interval}])"
    },
    "latency-and-rate-vs-time": {
      "latency_p50": "histogram_quantile(0.5, sum(rate(ppm_k6_success_req_latency_milliseconds_bucket{api=\"{api}\"}[{rate_interval}])) by (le))",
      "latency_p95": "histogram_quantile(0.95, sum(rate(ppm_k6_success_req_latency_milliseconds_bucket{api=\"{api}\"}[{rate_interval}])) by (le))",
      "goodput": "rate(ppm_k6_goodput_counter_total{api=\"{api}\"}[{rate_interval}])",
      "dropped": "rate(ppm_k6_dropped_counter_total{api=\"{api}\"}[{rate_interval}])",
      "slo_violation": "rate(ppm_k6_slo_violation_counter_total{api=\"{api}\"}[{rate_interval}])",
      "dropped_in": "rate(ppm_failed_rpc_total{api=\"{api}\"}[{rate_interval}])"
    },
    "resource-waste": {
      "accepted_rate": "rate(ppm_accepted_rpc_total{exported_job=\"{service}\", api=\"{api}\"}[{rate_interval}])",
      "dropped_rate": "rate(ppm_failed_rpc_total{exported_job=\"{service}\", api=\"{api}\"}[{rate_interval}])",
      "slo_violation_rate": "rate(ppm_k6_slo_violation_counter_total{api=\"{api}\"}[{rate_interval}])"
    },
    "max-queue": {
      "queue_length": "ppm_max_queue{exported_job=\"{service}\", api=\"{api}\"}"
    }
  },

  "report": {
    "embed_plots": true,
    "show_failed_only_section": true
  },

  "notes": "Add or override any additional keys; unknown keys are accessible via Config.extra"
}
